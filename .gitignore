# dependencies and build output
node_modules/
.pnpm-store/
dist/
.next/
.turbo/
out/
coverage/
*.tsbuildinfo

# environment and secrets (never commit)
.env
.env.*
!.env.example
.cli/

# local data (books, extracted text, database clusters, exports) live outside the repo by
# default; these patterns defend against accidental placement inside it
.data/
data/
*.pgdata/
library/originals/
library/processed/
library/quarantine/
library/exports/

# test and QA artifacts regenerated by commands
playwright-report/
test-results/
docs/qa/screenshots/*.png
!docs/qa/screenshots/.gitkeep

# owner build pack archive (extracted copy is in brief/)
*.zip

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Playwright signed-in state for the journeys (regenerated by the setup project)
tests/e2e/.auth/
