{
  "name": "corniversity",
  "version": "0.1.0",
  "private": true,
  "description": "Corniversity — Leon's private personal university",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "scripts": {
    "setup:check": "node scripts/setup-check.mjs",
    "db:local": "tsx scripts/db-local.ts",
    "db:local:stop": "tsx scripts/db-local.ts --stop",
    "db:generate": "pnpm --filter @corniversity/db generate",
    "db:migrate": "pnpm --filter @corniversity/db migrate",
    "db:seed": "pnpm --filter @corniversity/content seed",
    "db:seed:demo": "pnpm --filter @corniversity/content seed:demo",
    "content:validate": "pnpm --filter @corniversity/content validate",
    "dev": "pnpm --parallel --filter @corniversity/web --filter @corniversity/worker dev",
    "dev:web": "pnpm --filter @corniversity/web dev",
    "dev:worker": "pnpm --filter @corniversity/worker dev",
    "build": "pnpm -r build",
    "start:web": "pnpm --filter @corniversity/web start",
    "start:worker": "pnpm --filter @corniversity/worker start",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run --project core --project ai --project content --project worker --project companion --project web",
    "test:integration": "vitest run --project db",
    "test:e2e": "playwright test",
    "eval:academic": "vitest run --project academic-evals",
    "library:pair": "tsx apps/companion/src/index.ts pair",
    "library:watch": "tsx apps/companion/src/index.ts watch",
    "library:sync": "tsx apps/companion/src/index.ts sync",
    "library:status": "tsx apps/companion/src/index.ts status",
    "owner:reset-password": "tsx scripts/owner-reset-password.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "health": "tsx scripts/health.ts",
    "deploy:railway": "pwsh -File infra/deploy-railway.ps1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "embedded-postgres": "17.10.0-beta.17",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.0",
    "typescript": "5.9.3",
    "unpdf": "^2.1.0",
    "vitest": "3.2.7"
  }
}
