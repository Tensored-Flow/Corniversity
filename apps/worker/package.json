{
  "name": "@corniversity/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/worker.mjs",
    "start": "node dist/worker.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@corniversity/ai": "workspace:*",
    "@corniversity/content": "workspace:*",
    "@corniversity/core": "workspace:*",
    "@corniversity/db": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  }
}
