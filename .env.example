# Corniversity environment. Copy to .env and fill in. Never commit .env.

# --- Institution -----------------------------------------------------------
INSTITUTION_NAME=Corniversity
DEFAULT_TIMEZONE=Europe/London
# local | production. Local mode treats "private cloud storage" as on-device storage.
DEPLOYMENT_MODE=local

# --- Database ---------------------------------------------------------------
# Local: `pnpm db:local` starts an embedded PostgreSQL 17 cluster on this URL.
DATABASE_URL=postgres://corniversity:corniversity@127.0.0.1:5437/corniversity
# Where private data lives (books, extracted text, local cluster, exports). Outside the repo.
CORNIVERSITY_DATA_ROOT=C:\Users\leona\Documents\Corniversity-Library

# --- Web ---------------------------------------------------------------------
PORT=3000
BETTER_AUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=change-me-to-32-plus-random-characters

# --- Owner bootstrap (single-owner, invite-only afterwards) -------------------
# The first account may only be created with this email AND this one-time code.
OWNER_EMAIL=you@example.com
OWNER_BOOTSTRAP_CODE=change-me-one-time-code

# --- AI provider (off by default; fixture provider is deterministic and free) -
# fixture | anthropic
AI_PROVIDER=fixture
# ANTHROPIC_API_KEY=
AI_MODEL_DEFAULT=claude-opus-5-5
# Budgets in USD. New paid work stops when a limit is reached.
AI_BUDGET_PER_RUN_USD=0.50
AI_BUDGET_DAILY_USD=3.00
AI_BUDGET_MONTHLY_USD=40.00

# --- Storage -----------------------------------------------------------------
# fs (local mode, under CORNIVERSITY_DATA_ROOT) | pg (production: blobs in PostgreSQL)
BLOB_STORE=fs
MAX_UPLOAD_MB=200

# --- Worker -------------------------------------------------------------------
